<mxfile host="app.diagrams.net" type="device">
  <diagram id="fig_mdp_loop" name="Figure 2 - SeqSQLi agent-environment loop">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ NODES ============ -->

        <mxCell id="agent"
          value="&lt;b style=&quot;font-size:15px&quot;&gt;Agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;policy&amp;nbsp; πθ : sₜ → aₜ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;MLP 2×64, tanh&lt;/span&gt;"
          style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#333333;strokeWidth=1.2;fontColor=#000000;fontSize=13;verticalAlign=middle;spacing=4;"
          vertex="1" parent="1">
          <mxGeometry x="32" y="94" width="192" height="63" as="geometry" />
        </mxCell>

        <mxCell id="mutate"
          value="&lt;b style=&quot;font-size:14px&quot;&gt;Apply mutation&amp;nbsp; aₜ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;pₜ₊₁ = gₐₜ(pₜ)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;semantics preserved&lt;/span&gt;"
          style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.2;fontColor=#000000;fontSize=13;verticalAlign=middle;spacing=4;"
          vertex="1" parent="1">
          <mxGeometry x="304" y="94" width="208" height="63" as="geometry" />
        </mxCell>

        <mxCell id="waf"
          value="&lt;b style=&quot;font-size:14px&quot;&gt;WAF + application&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;ModSecurity / Safeline&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;+ sqli-labs&lt;/span&gt;"
          style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.2;fontColor=#000000;fontSize=13;verticalAlign=middle;spacing=4;"
          vertex="1" parent="1">
          <mxGeometry x="576" y="94" width="192" height="63" as="geometry" />
        </mxCell>

        <mxCell id="response"
          value="&lt;b style=&quot;font-size:14px&quot;&gt;Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;status, body&lt;/span&gt;"
          style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.2;fontColor=#000000;fontSize=13;verticalAlign=middle;spacing=4;"
          vertex="1" parent="1">
          <mxGeometry x="576" y="220" width="192" height="55" as="geometry" />
        </mxCell>

        <mxCell id="reward"
          value="&lt;b style=&quot;font-size:14px&quot;&gt;Reward&amp;nbsp; rₜ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;strict success + PBRS shaping&lt;/span&gt;"
          style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.2;fontColor=#000000;fontSize=13;verticalAlign=middle;spacing=4;"
          vertex="1" parent="1">
          <mxGeometry x="304" y="220" width="208" height="55" as="geometry" />
        </mxCell>

        <!-- ============ EDGES ============ -->

        <mxCell id="e_action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"
          edge="1" parent="1" source="agent" target="mutate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l_action" value="action aₜ"
          style="edgeLabel;html=1;align=center;verticalAlign=middle;fontStyle=2;fontColor=#444444;fontSize=12;labelBackgroundColor=none;"
          vertex="1" connectable="0" parent="e_action">
          <mxGeometry x="-0.1" y="-14" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="e_http" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"
          edge="1" parent="1" source="mutate" target="waf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l_http" value="HTTP request"
          style="edgeLabel;html=1;align=center;verticalAlign=middle;fontStyle=2;fontColor=#444444;fontSize=12;labelBackgroundColor=none;"
          vertex="1" connectable="0" parent="e_http">
          <mxGeometry x="0" y="-46" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="e_resp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" parent="1" source="waf" target="response">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l_resp" value="response"
          style="edgeLabel;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;fontSize=12;labelBackgroundColor=none;"
          vertex="1" connectable="0" parent="e_resp">
          <mxGeometry x="0.1" y="30" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="e_back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"
          edge="1" parent="1" source="response" target="reward">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;"
          edge="1" parent="1" source="reward" target="agent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="128" y="247" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l_loop" value="sₜ₊₁ , rₜ"
          style="edgeLabel;html=1;align=right;verticalAlign=middle;fontStyle=2;fontColor=#444444;fontSize=12;labelBackgroundColor=none;"
          vertex="1" connectable="0" parent="e_loop">
          <mxGeometry x="0.55" y="0" relative="1" as="geometry"><mxPoint x="-14" as="offset" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
