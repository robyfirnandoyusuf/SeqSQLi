SAFELINE_DIR=/data/safeline
IMAGE_TAG=latest
MGT_PORT=9443
POSTGRES_PASSWORD=change_this_password
# SUBNET_PREFIX must not overlap with existing Docker networks.
# Run: docker network ls + docker network inspect <name> to check.
# Default sqlilab uses 172.22.0.0/16 — so use 172.23.222 here.
SUBNET_PREFIX=172.23.222
ARCH_SUFFIX=
IMAGE_PREFIX=swr.cn-east-3.myhuaweicloud.com/chaitin-safeline
RELEASE=
# REGION=-g enables English UI (global edition)
REGION=-g
